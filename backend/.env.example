# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key is used by the backend so it can bypass RLS for writes.
# Keep this secret — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin API secret — protect write endpoints (POST/PUT/DELETE on /api/blog/admin/*)
# Set to any long random string, e.g.: openssl rand -hex 32
ADMIN_SECRET=change_me_to_a_long_random_string

# App
PORT=3001
